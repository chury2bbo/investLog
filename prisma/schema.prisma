generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model BrokerageCompany {
  code           String          @id
  name           String
  financialCode  String
  createdAt      DateTime        @default(now())
  investAccounts InvestAccount[]
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  password       String?
  provider       String?
  onboardingDone Boolean         @default(false)
  assetGoal      BigInt?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailVerified  DateTime?
  image          String?
  sessions       Session[]
  investAccounts InvestAccount[]
  analysisLogs   UserAnalysisLog[]
  assetSnapshots MonthlyAssetSnapshot[]
  oauthAccounts  Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("nextauth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestAccount {
  id               Int              @id @default(autoincrement())
  userId           String
  accountCode      String
  accountNumber    String?
  memo             String?
  createdAt        DateTime         @default(now())
  cashBalances     CashBalance[]
  cashLogs         CashLog[]
  holdings         Holding[]
  tradeLogs        TradeLog[]
  brokerageCompany BrokerageCompany @relation(fields: [accountCode], references: [code])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Holding {
  id           Int           @id @default(autoincrement())
  accountId    Int
  ticker       String
  name         String
  country      String
  avgPrice     Float
  quantity     Int
  sectorAuto   String?
  sectorManual String?
  tags         String[]
  updatedAt    DateTime      @updatedAt
  account      InvestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, ticker])
  @@index([accountId])
}

model TradeLog {
  id         Int           @id @default(autoincrement())
  date       DateTime
  accountId  Int
  ticker     String
  name       String
  type       String
  price      Float
  quantity   Int
  reasonTags String[]
  emotion    String?
  reasonMemo String?
  memo       String?
  createdAt  DateTime      @default(now())
  account    InvestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cashLog    CashLog?

  @@index([accountId])
  @@index([date])
}

model CashBalance {
  id        Int           @id @default(autoincrement())
  accountId Int
  currency  String
  amount    Float
  account   InvestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, currency])
}

model CashLog {
  id         Int           @id @default(autoincrement())
  date       DateTime
  accountId  Int
  type       String
  currency   String
  amount     Float
  memo       String?
  ticker     String?
  tradeLogId Int?          @unique
  createdAt  DateTime      @default(now())
  account    InvestAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tradeLog   TradeLog?     @relation(fields: [tradeLogId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([tradeLogId])
}

model StockMaster {
  ticker    String   @id
  name      String
  market    String
  country   String
  assetType String   @default("STOCK")
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("stock_master")
}

model TickerSummaryCache {
  ticker    String   @id
  summaryKo String
  updatedAt DateTime @updatedAt

  @@map("ticker_summary_cache")
}

model TickerAnalysisCache {
  ticker          String   @id
  recommendation  String
  targetBuy       String
  targetSell      String
  swotStrength    String
  swotWeakness    String
  swotOpportunity String
  swotThreat      String
  reasoning       String
  recentIssues    String @default("")
  cachedDate      String
  updatedAt       DateTime @updatedAt

  @@map("ticker_analysis_cache")
}

model UserAnalysisLog {
  id        Int      @id @default(autoincrement())
  userId    String
  ticker    String
  name      String
  country   String   @default("KR")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_analysis_logs")
}

model MonthlyAssetSnapshot {
  id              Int      @id @default(autoincrement())
  userId          String
  date            DateTime @db.Date
  cashTotal       Float
  investedAmount  Float
  evaluatedAmount Float
  usdRate         Float
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("monthly_asset_snapshots")
}

model ApiUsageLog {
  id           Int    @id @default(autoincrement())
  userId       String
  type         String
  date         String
  count        Int    @default(0)
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)

  @@unique([userId, type, date])
  @@map("api_usage_log")
}

model PersonalityResult {
  id             Int      @id @default(autoincrement())
  userId         String
  dateKey        String
  type           String
  summary        String
  winRate        Float?
  avgHoldingDays Int?
  lossRatio      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, dateKey])
  @@map("personality_result")
}

model CoachingHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  strengths String
  mistakes  String
  goals     String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("coaching_history")
}
